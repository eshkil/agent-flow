#!/usr/bin/env bash
# kando-session: повідомляє Kando, що ця локальна сесія Claude Code тримає задачу.
#   kando-session begin --session <id> [--repo <owner/name>] --number <N> --skill <name> [--takeover]
#   kando-session end --session <id>
#   kando-session hook post-tool|pre-tool|session-end   (JSON хука — зі stdin)
# Лише bash 3.2 і curl (jq може бракувати). Збої мережі скіл не зупиняють:
# єдиний «зупиняючий» код — 3 у begin (задачу вже тримає інша сесія або перебрати її не вдалось).

# У GitHub Actions задачею керує диспетчер Kando, а не локальна сесія.
[ "${GITHUB_ACTIONS:-}" = "true" ] && exit 0

KANDO_URL=${KANDO_URL:-https://kando-board.pp.ua}
KANDO_URL=${KANDO_URL%/}
CONF_DIR="$HOME/.config/kando"
SDIR="$CONF_DIR/sessions"
TOKEN_FILE="$CONF_DIR/token"
BEAT_EVERY=60   # сигнал не частіше разу на 60 с
# Текст для Claude, коли задачу втрачено. Нічого не пропонує робити самому:
# begin: true перекриває кнопку «Відпустити», тож рішення за людиною. Але вихід назвати
# треба: стан лишається, і без end пуші в цьому репо заблоковані на всю сесію.
STOP_TEXT="Задачу втрачено. Зупинись: нічого не пуш і не змінюй PR, скажи про це людині й чекай її рішення. Лише якщо людина вирішить кинути задачу, виконай крок «Відпустити задачу в Kando»: це зніме блокування пушів у цьому репо. Сам цього не роби."

RESP_STATUS=000
RESP_BODY=

# ─── допоміжне ───────────────────────────────────────────────────────────────

# Перевірки через case, а не grep '^…$': grep працює по рядках, тож
# $'abc\n../../pwn' пройшов би.
valid_id() { case "$1" in ''|*[!A-Za-z0-9-]*) return 1 ;; esac; }
valid_number() { case "$1" in ''|*[!0-9]*) return 1 ;; esac; }
valid_skill() { case "$1" in ''|*[!A-Za-z0-9_-]*) return 1 ;; esac; }

# Є непорожній токен?
have_token() {
  [ -r "$TOKEN_FILE" ] && [ -n "$(tr -d ' \r\n\t' < "$TOKEN_FILE" 2>/dev/null)" ]
}

# Значення рядкового поля JSON — ПЕРШЕ входження ключа, з екрануваннями як є.
# Поля верхнього рівня (session_id, cwd) у stdin хука йдуть раніше за
# tool_input, тож вкладений tool_input.cwd їх не перекриває. Лапки всередині
# рядків екрановані (\"), тож ключ усередині значення не збігається.
json_str() { # json name
  printf '%s' "$1" | grep -oE '"'"$2"'"[[:space:]]*:[[:space:]]*"(([^"\\]|\\.)*)"' | head -1 \
    | sed -E 's/^"[^"]*"[[:space:]]*:[[:space:]]*"//; s/"$//'
}

# Для вставки в JSON і показу людині: без лапок, слешів і переносів рядків.
sanitize() {
  printf '%s' "$1" | tr '\r\n\t' '   ' | sed -E 's/\\[nrt]/ /g; s/\\u[0-9a-fA-F]{4}/?/g' | tr -d '"\\' | cut -c1-500
}

# git remote origin → owner/repo (лише github.com).
repo_of() { # dir
  local u r
  u=$(git -C "$1" remote get-url origin 2>/dev/null) || return 1
  u=${u%/}; u=${u%.git}
  u=${u#*://}; u=${u#*@}
  case "$u" in
    github.com:*) r=${u#github.com:} ;;
    github.com/*) r=${u#github.com/} ;;
    *) return 1 ;;
  esac
  case "$r" in
    */*/*|''|/*|*/|*[!A-Za-z0-9._/-]*) return 1 ;;
    */*) ;;
    *) return 1 ;;
  esac
  printf '%s' "$r"
}

# Назви репозиторіїв GitHub не чутливі до регістру.
same_repo() { [ "$(printf '%s' "$1" | tr 'A-Z' 'a-z')" = "$(printf '%s' "$2" | tr 'A-Z' 'a-z')" ]; }

state_get() { sed -n "s/^$2=//p" "$1" | head -1; }

# began відрізняє кожен begin: хук звіряє файл, щоб не прийняти пізню відповідь за нову задачу.
state_put() { # id repo number skill
  printf 'repo=%s\nnumber=%s\nskill=%s\nbegan=%s.%s\n' "$2" "$3" "$4" "$$" "$(date +%s)" > "$SDIR/$1"
}

drop_state() { # id
  rm -f "$SDIR/$1" "$SDIR/$1.beat" "$SDIR/$1.warned" "$SDIR/$1.pending" "$SDIR/$1.refused"
}

# HTTP-виклик. Токен іде в curl через конфіг на stdin, а не в аргументах
# (аргументи видно іншим користувачам у ps). Результат: RESP_STATUS, RESP_BODY.
api() { # METHOD id query timeout [body]
  local method=$1 id=$2 query=$3 tmo=$4 body=${5:-} tok out
  RESP_STATUS=000; RESP_BODY=
  have_token || return 1
  tok=$(tr -d ' \r\n\t' < "$TOKEN_FILE" | sed 's/\\/\\\\/g; s/"/\\"/g')
  [ -n "$tok" ] || return 1
  if [ -n "$body" ]; then
    out=$(printf 'header = "Authorization: Bearer %s"\n' "$tok" | curl -sS -K - -m "$tmo" \
      -X "$method" -H 'Content-Type: application/json' --data-binary "$body" \
      -w '\n%{http_code}' "$KANDO_URL/api/agent/local-sessions/$id$query" 2>/dev/null)
  else
    out=$(printf 'header = "Authorization: Bearer %s"\n' "$tok" | curl -sS -K - -m "$tmo" \
      -X "$method" -w '\n%{http_code}' "$KANDO_URL/api/agent/local-sessions/$id$query" 2>/dev/null)
  fi
  case "$out" in
    *$'\n'*) RESP_STATUS=${out##*$'\n'}; RESP_BODY=${out%$'\n'*} ;;
  esac
  [ -n "$RESP_STATUS" ] || RESP_STATUS=000
  return 0
}

put_body() { # repo number skill [extra]
  printf '{"repo":"%s","number":%s,"skill":"%s"%s}' "$1" "$2" "$3" "${4:-}"
}

not_managed() { printf '%s' "$RESP_BODY" | grep -Eq '"managed"[[:space:]]*:[[:space:]]*false'; }

# ─── begin / end ─────────────────────────────────────────────────────────────

cmd_begin() {
  local session= number= skill= takeover= want= repo body msg
  while [ $# -gt 0 ]; do
    case "$1" in
      --session) session=${2:-}; shift ;;
      --repo) want=${2:-}; shift ;;
      --number) number=${2:-}; shift ;;
      --skill) skill=${2:-}; shift ;;
      --takeover) takeover=1 ;;
    esac
    shift
  done
  # Без сервера перебирання не відбулось, а інша сесія досі тримає задачу: код 0 означав би «працюй далі».
  local skip=0
  local note=; [ -z "$takeover" ] || { skip=3; note=" Перебирання не відбулось."; }
  if ! valid_id "$session"; then echo "Kando: некоректний id сесії, пропускаю.$note"; return $skip; fi
  if ! valid_number "$number"; then echo "Kando: некоректний номер задачі, пропускаю.$note"; return $skip; fi
  if ! valid_skill "$skill"; then echo "Kando: некоректна назва скіла, пропускаю.$note"; return $skip; fi

  mkdir -p "$SDIR" 2>/dev/null
  find "$SDIR" -type f -mtime +7 -exec rm -f {} + 2>/dev/null

  if ! have_token; then
    echo "Kando: токена немає (~/.config/kando/token), сесію не позначено."
    return $skip
  fi
  if ! repo=$(repo_of "$PWD"); then
    echo "Kando: origin не є репозиторієм GitHub, сесію не позначено."
    return $skip
  fi
  # Скіл працює з репо, яке назвала людина, а хуки й гілка — із цієї директорії. Позначити за
  # origin означало б чужу картку. Порожнє значення: змінна не збереглась, лишається origin.
  if [ -n "$want" ] && ! same_repo "$want" "$repo"; then
    echo "Kando: скіл працює з репозиторієм $(sanitize "$want"), а origin цієї директорії — $repo. Сесію не позначено."
    return $skip
  fi

  body=$(put_body "$repo" "$number" "$skill" ',"begin":true'"${takeover:+,\"takeover\":true}")
  api PUT "$session" "" 20 "$body"
  case "$RESP_STATUS" in
    200)
      if not_managed; then
        echo "Kando: репозиторій $repo не керується Kando, сесію не позначено."
      else
        state_put "$session" "$repo" "$number" "$skill"
        date +%s > "$SDIR/$session.beat"
        rm -f "$SDIR/$session.warned" "$SDIR/$session.pending" "$SDIR/$session.refused"
        echo "Kando: задачу #$number закріплено за цією сесією."
      fi ;;
    409)
      msg=$(sanitize "$(json_str "$RESP_BODY" message)")
      echo "Kando: ${msg:-задачу вже тримає інша сесія.}"
      # Сервер відмовив і скіл зупиняється, тож хуки не мають повторювати begin, що чекав відповіді.
      if [ -f "$SDIR/$session.pending" ]; then
        rm -f "$SDIR/$session.pending"
        printf '%s' "${msg:-задачу вже тримає інша сесія.}" > "$SDIR/$session.refused"
      fi
      return 3 ;;
    401|403)
      echo "Kando: токен не прийнято або немає права запису в репозиторій ($RESP_STATUS), перевірте ~/.config/kando/token і свої права. Сесію не позначено."
      [ -z "$takeover" ] || return 3 ;;
    400)
      echo "Kando: запит відхилено (400), сесію не позначено."
      [ -z "$takeover" ] || return 3 ;;
    *)
      # Перебирання вирішує людина, а скіл тут зупиниться: хук не сміє виконати його потім. Відповідь
      # могла лише загубитись, тож повторити команду безпечно.
      if [ -n "$takeover" ]; then
        echo "Kando: сервер не відповів ($RESP_STATUS), перебирання не підтверджено. Повтори команду, коли Kando відповідатиме."
        return 3
      fi
      # Сервер не відповів або віддав 5xx: працюємо далі, хуки спробують ще. Сигнал без begin
      # не повертає задачу після skill_done, тож .pending каже хукам повторити сам begin.
      state_put "$session" "$repo" "$number" "$skill"
      rm -f "$SDIR/$session.beat" "$SDIR/$session.warned" "$SDIR/$session.refused"
      : > "$SDIR/$session.pending"
      echo "Kando: сервер недоступний ($RESP_STATUS), продовжую без підтвердження."
      ;;
  esac
  return 0
}

cmd_end() {
  local session= f
  while [ $# -gt 0 ]; do
    case "$1" in --session) session=${2:-}; shift ;; esac
    shift
  done
  valid_id "$session" || return 0
  f="$SDIR/$session"
  [ -f "$f" ] || return 0
  api DELETE "$session" "?reason=skill_done" 5
  drop_state "$session"
  return 0
}

# ─── хуки ────────────────────────────────────────────────────────────────────

# Спільна підготовка: INPUT, SESSION, STATE, SNAP, REPO, NUMBER, SKILL; 1 — нічого робити.
hook_prepare() {
  INPUT=$(cat)
  SESSION=$(printf '%s' "$INPUT" | grep -oE '"session_id"[[:space:]]*:[[:space:]]*"[A-Za-z0-9-]+"' | head -1 | sed 's/.*:[[:space:]]*"\(.*\)"/\1/')
  valid_id "$SESSION" || return 1
  STATE="$SDIR/$SESSION"
  [ -f "$STATE" ] || return 1
  SNAP=$(cat "$STATE" 2>/dev/null)
  REPO=$(state_get "$STATE" repo)
  NUMBER=$(state_get "$STATE" number)
  SKILL=$(state_get "$STATE" skill)
  [ -n "$REPO" ] && [ -n "$NUMBER" ] && [ -n "$SKILL" ] || return 1
  return 0
}

# Сесія працює в тому самому репозиторії, що й задача?
hook_same_repo() {
  local cwd cur
  cwd=$(json_str "$INPUT" cwd | sed 's/\\\\/\\/g; s/\\\//\//g')
  [ -n "$cwd" ] || cwd=$PWD
  cur=$(repo_of "$cwd") || return 1
  same_repo "$cur" "$REPO"
}

# Сигнал; якщо сервер не відповів на begin, то й він сам. Після нього RESP_STATUS/RESP_BODY заповнені.
hook_signal() { # timeout
  local extra=
  [ -f "$STATE.pending" ] && extra=',"begin":true'
  api PUT "$SESSION" "" "$1" "$(put_body "$REPO" "$NUMBER" "$SKILL" "$extra")"
  # Поки чекали відповідь, скіл закінчився чи почався інший: вона стосується старого стану.
  if [ "$(cat "$STATE" 2>/dev/null)" != "$SNAP" ]; then
    RESP_STATUS=stale
    return 0
  fi
  case "$RESP_STATUS" in
    200) if not_managed; then drop_state "$SESSION"; else rm -f "$STATE.warned" "$STATE.pending"; fi ;;
    401|403) drop_state "$SESSION" ;;
    409)
      if printf '%s' "$RESP_BODY" | grep -Eq '"lost"[[:space:]]*:[[:space:]]*"moved"'; then
        # Сервер уже веде цю сесію на іншій задачі, а begin іще не відповів: нічого не втрачено.
        RESP_STATUS=stale
      elif printf '%s' "$RESP_BODY" | grep -Eq '"lost"[[:space:]]*:[[:space:]]*"skill_done"'; then
        # Запізнілий сигнал після кінця скіла: нічого не втрачено, лише прибрати стан.
        drop_state "$SESSION"
      elif [ -n "$extra" ]; then
        # Це відмова на begin: те саме, що код 3. Зупинена сесія не забирає задачу пізніше, коли
        # тримач закінчить, тож запитів більше немає, а стан лишається, щоб блокувати пуші.
        rm -f "$STATE.pending"
        hook_message > "$STATE.refused"
      fi ;;
  esac
}

# Токен не прийнято посеред роботи: стан щойно видалено, разом із ним зник і захист. Сказати
# можна лише тут: наступні хуки стану вже не побачать, тож це і є «один раз».
hook_auth_notice() { # hookEventName
  case "$RESP_STATUS" in
    401|403) printf '{"hookSpecificOutput":{"hookEventName":"%s","additionalContext":"Kando: токен не прийнято або немає права запису (%s). Kando більше не знає про цю сесію, перевірки перед пушем немає. Скажи про це людині; працювати можна далі."}}\n' "$1" "$RESP_STATUS" ;;
  esac
}

hook_message() {
  local m
  m=$(sanitize "$(json_str "$RESP_BODY" message)")
  [ -n "$m" ] || m="задачу #$NUMBER тримає інша сесія."
  printf '%s' "$m"
}

hook_post_tool() {
  hook_prepare || return 0
  [ -f "$STATE.refused" ] && return 0
  hook_same_repo || return 0
  local now beat m
  now=$(date +%s)
  beat=$(cat "$STATE.beat" 2>/dev/null)
  printf '%s' "$beat" | grep -Eq '^[0-9]+$' || beat=0
  [ $((now - beat)) -lt $BEAT_EVERY ] && return 0
  echo "$now" > "$STATE.beat"
  hook_signal 5
  hook_auth_notice PostToolUse
  if [ "$RESP_STATUS" = 409 ] && [ ! -e "$STATE.warned" ] && [ -f "$STATE" ]; then
    : > "$STATE.warned"
    m=$(hook_message)
    printf '{"hookSpecificOutput":{"hookEventName":"PostToolUse","additionalContext":"Kando: %s %s"}}\n' "$m" "$STOP_TEXT"
  fi
  return 0
}

# Команда згадує git push або зміну PR через gh? Навмисно не розбираємо shell: heredoc, апострофи,
# перенесення рядків, підстановки й обгортки ховали пуш від розбору. Перевірка лише питає сервер: поки
# задача утримується, зайвий запит нічого не коштує, а хибна заборона можлива тільки в сесії, якій уже
# сказано зупинитись. Вхід — значення "command" як у JSON (з екрануваннями).
has_word() { # text alternatives
  printf '%s' "$1" | grep -Eq "(^|[^[:alnum:]_-])($2)(\$|[^[:alnum:]_-])"
}
is_guarded_command() { # json-escaped command
  local text
  # Окремі case: зразок із двома словами квадратичний на команді з багатьма git і без push.
  case "$1" in *push*) case "$1" in *git*) return 0 ;; esac ;; esac
  case "$1" in *gh*) ;; *) return 1 ;; esac
  case "$1" in *pr*) ;; *) return 1 ;; esac
  text=$(printf '%s' "$1" | sed 's/\\[nrt]/ /g')
  has_word "$text" gh && has_word "$text" pr \
    && has_word "$text" 'create|edit|merge|close|ready|review|reopen|comment|update-branch|revert|lock|unlock'
}

hook_pre_tool() {
  hook_prepare || return 0
  is_guarded_command "$(json_str "$INPUT" command)" || return 0
  hook_same_repo || return 0
  if [ -f "$STATE.refused" ]; then
    printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"Kando: %s %s"}}\n' "$(cat "$STATE.refused" 2>/dev/null)" "$STOP_TEXT"
    return 0
  fi
  hook_signal 5
  hook_auth_notice PreToolUse
  if [ "$RESP_STATUS" = 409 ] && [ -f "$STATE" ]; then
    printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"Kando: %s %s"}}\n' "$(hook_message)" "$STOP_TEXT"
  fi
  return 0
}

hook_session_end() {
  hook_prepare || return 0
  api DELETE "$SESSION" "?reason=session_end" 4
  # Повна очистка лише для /clear; інакше (вихід, resume) стан лишається.
  if printf '%s' "$INPUT" | grep -Eq '"reason"[[:space:]]*:[[:space:]]*"clear"'; then
    drop_state "$SESSION"
  fi
  return 0
}

# ─── диспетчер ───────────────────────────────────────────────────────────────

case "${1:-}" in
  begin) shift; cmd_begin "$@"; exit $? ;;
  end) shift; cmd_end "$@"; exit 0 ;;
  hook)
    case "${2:-}" in
      post-tool) hook_post_tool ;;
      pre-tool) hook_pre_tool ;;
      session-end) hook_session_end ;;
    esac
    exit 0 ;;
  *) echo "Використання: kando-session begin|end|hook ..." >&2; exit 0 ;;
esac
