#!/usr/bin/env bash
# git credential helper: видає токен GitHub App з файлу лише для github.com.
# Протокол: git пише на stdin пари key=value, а ми відповідаємо ними ж на stdout.
set -eu

[ "${1:-}" = "get" ] || exit 0

host=""
while IFS= read -r line && [ -n "$line" ]; do
  case "$line" in host=*) host="${line#host=}" ;; esac
done
[ "$host" = "github.com" ] || exit 0

token_file="${KANDO_TOKEN_FILE:-${KANDO_DIR:-${RUNNER_TEMP:-/tmp}/kando}/token}"
[ -r "$token_file" ] || exit 0
printf 'username=x-access-token\npassword=%s\n' "$(cat "$token_file")"
