#!/usr/bin/env bash
# git credential helper: видає токен GitHub App з файлу лише для https://github.com
# (http чи інший протокол передали б токен відкритим текстом).
# Протокол: git пише на stdin пари key=value, а ми відповідаємо ними ж на stdout.
set -eu

[ "${1:-}" = "get" ] || exit 0

host=""
protocol=""
while IFS= read -r line && [ -n "$line" ]; do
  case "$line" in
    host=*) host="${line#host=}" ;;
    protocol=*) protocol="${line#protocol=}" ;;
  esac
done
[ "$protocol" = "https" ] && [ "$host" = "github.com" ] || exit 0

token_file="${KANDO_TOKEN_FILE:-${KANDO_DIR:-${RUNNER_TEMP:-/tmp}/kando}/token}"
[ -r "$token_file" ] || exit 0
printf 'username=x-access-token\npassword=%s\n' "$(cat "$token_file")"
